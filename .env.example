# Public identifiers only. Never put a client secret, token or signing key here.

# AniList application id (public). Empty disables AniList sign-in.
VITE_ANILIST_CLIENT_ID=

# Cloudflare Turnstile site key for the first-visit check. Empty disables the check.
# Local development may use Cloudflare's always-pass test key: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
