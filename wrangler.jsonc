{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anilife-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "production",
    "DISCORD_CLIENT_ID": "1567279187893551185"
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "anilife.cc", "custom_domain": true },
    { "pattern": "www.anilife.cc", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "r2_buckets": [
    { "binding": "RELEASE_INDEX_BUCKET", "bucket_name": "anilife-release-index" }
  ],
  "d1_databases": [
    {
      "binding": "RELEASE_INDEX_USAGE",
      "database_name": "anilife-release-index-usage",
      "database_id": "ab0cee67-1147-43d1-adf5-6123f5d1fa81"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
