{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anilife-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "vars": {
    "APP_ENV": "production",
    "DISCORD_CLIENT_ID": "1567279187893551185",
    "AUTH_BASE_URL": "https://anilife.cc"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "anilife.cc", "custom_domain": true },
    { "pattern": "www.anilife.cc", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "r2_buckets": [
    { "binding": "RELEASE_INDEX_BUCKET", "bucket_name": "anilife-release-index" }
  ],
  "d1_databases": [
    {
      "binding": "RELEASE_INDEX_USAGE",
      "database_name": "anilife-release-index-usage",
      "database_id": "ab0cee67-1147-43d1-adf5-6123f5d1fa81"
    },
    {
      "binding": "ANILIFE_CLOUD_DB",
      "database_name": "anilife-cloud-sync",
      "database_id": "8b72ce9e-895d-4d38-bb47-07ea776d91de",
      "migrations_dir": "migrations/cloud-sync"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/auth/callback.js",
      "!/manifest.webmanifest",
      "!/robots.txt",
      "!/sw.js",
      "!/theme-init.js"
    ]
  }
}
