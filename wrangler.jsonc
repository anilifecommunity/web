{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anilife-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
